{
  "name": "aura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ai": "RUN_AI_TESTS=1 vitest run tests/safety",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --linked > lib/db/types.ts",
    "calibrate": "tsx scripts/calibrate-scores.ts",
    "grant:tester": "tsx scripts/grant-tester.ts",
    "fairness": "tsx --conditions=react-server scripts/fairness-report.ts",
    "compare:observers": "tsx --conditions=react-server scripts/compare-observers.ts",
    "refit:engine": "tsx --conditions=react-server scripts/refit-engine.ts",
    "test:rls": "RLS_TESTS=1 vitest run tests/rls",
    "db:check-rls": "bash scripts/check-rls.sh",
    "mediapipe:setup": "node scripts/setup-mediapipe.mjs",
    "prebuild": "node scripts/setup-mediapipe.mjs",
    "predev": "node scripts/setup-mediapipe.mjs",
    "test:e2e:privacy": "PRIVACY_E2E=1 playwright test --project=privacy",
    "test:e2e:billing": "BILLING_E2E=1 playwright test --project=billing",
    "db:push:api": "node scripts/supabase-api-migrate.mjs",
    "mobile:install": "pnpm --dir mobile install",
    "mobile:typecheck": "pnpm --dir mobile typecheck",
    "mobile:lint": "pnpm --dir mobile lint",
    "mobile:test": "pnpm --dir mobile test",
    "mobile:export": "pnpm --dir mobile export",
    "dev:bootstrap": "node scripts/dev-bootstrap.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "^2.28.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@sentry/nextjs": "^11.12.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.449.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
