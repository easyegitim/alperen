NEXT_PUBLIC_APP_NAME=Aura
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # publishable key
SUPABASE_SERVICE_ROLE_KEY=                # GİZLİ
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=                     # GİZLİ (Supabase Auth captcha ayarına da girilir)
GEMINI_API_KEY=                           # GİZLİ, faturalandırması açık proje
GEMINI_SCORE_MODEL=gemini-3.5-flash-lite
GEMINI_SCORE_FALLBACK_MODEL=gemini-3.5-flash  # birincil model 503 (yoğunluk) verirse son çare; boş = kapalı
GEMINI_COACH_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
FAL_KEY=                                  # isteğe bağlı, GİZLİ
TRYON_PROVIDER=gemini                     # gemini | fal
FAL_TRYON_MODEL=fal-ai/flux-pro/v1/fill   # TRYON_PROVIDER=fal iken
# Claude (Anthropic): gözlem ve koç raporu (engine spec §9.1). Yalnız sunucu; NEXT_PUBLIC_/EXPO_PUBLIC_ önekiyle asla.
ANTHROPIC_API_KEY=                        # GİZLİ
SCORE_ENGINE=hybrid.v2                    # legacy | hybrid.v1 | hybrid.v2 — v2 arayüzünün ödeme sonrası yolu (/run, mode full) yalnız hybrid.v2'de açık;
                                          # ödeme öncesi device_only yol motordan bağımsızdır. production'a hybrid.v2 SPEC 19 kapısından sonra
# hybrid.v2 (CONTRACTS_V2.md §4): yapısal üçlü kaynağı ve kalibrasyon h2; herkes için aynı, ödeme girdisi yok
STRUCTURAL_SOURCE=blend                   # claude | geometry | blend (0,5 Claude + 0,5 geometri)
CALIBRATION_H2_CENTER=5.5                 # 3–8
CALIBRATION_H2_SD=1.5                     # 0,5–3
SET_CACHE_SECRET=                         # GİZLİ: aynı fotoğraf seti 1 yıl aynı skor (HMAC-SHA-256 set anahtarı); boş = önbellek kapalı
AI_OBSERVE_PROVIDER=claude                # claude | gemini (aynı şema ve motorla karşılaştırma)
AI_COACH_PROVIDER=gemini                  # gemini | claude
CLAUDE_OBSERVE_MODEL=claude-opus-5-5
CLAUDE_OBSERVE_EFFORT=low                 # low | medium | high
CLAUDE_COACH_MODEL=claude-opus-5-5
CLAUDE_COACH_EFFORT=low                   # low | medium | high
CLAUDE_SCORE_MODEL=claude-opus-5-5        # hybrid.v2 puan cetveli çağrısı (tüm açılar tek mesajda)
CLAUDE_SCORE_EFFORT=medium                # low | medium | high
CLAUDE_AUDIT_EFFORT=low                   # hybrid.v2 denetim geçişi (Ek B dili + puan tutarlılığı)
CLAUDE_FALLBACKS=default                  # default | off (off: tek model, adalet denetimleri için)
CLAUDE_CACHE_TTL=1h                       # 1h | 5m
OBSERVE_CALLS=3                           # 1–5 paralel gözlem çağrısı
GEMINI_OBSERVE_MODEL=gemini-3.5-flash     # yalnız AI_OBSERVE_PROVIDER=gemini iken
IYZICO_API_KEY=                           # GİZLİ
IYZICO_SECRET_KEY=                        # GİZLİ
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_PLAN_WEEKLY_REF=
IYZICO_PLAN_MONTHLY_REF=
IYZICO_PLAN_YEARLY_REF=
TEASER_MODE=shape_plus_one                # shape_plus_one | overall_only | shape_only
TEASER_SUBSCORE=skin
SCORE_CALIBRATION_VERSION=v0
FEATURE_EXPERT_NETWORK=false
FEATURE_WEEK_PASS=false
# v2 bayrakları (CONTRACTS_V2.md §6): hepsi kapalı başlar; yalnız "true" açar
FEATURE_UNDER_18=false                    # 18 altı yaş bandı girişi (avukat onayı)
FEATURE_PERCENTILE=false                  # genel skorda yüzdelik (Anthropic teyidi)
FEATURE_DOCTOR_LAYER=false                # doktor katmanı (hekim inceleme akışı)
FEATURE_REFERRAL_UNLOCK=false             # 5 davetle genel skor
FEATURE_YEARLY_PLAN=false                 # yıllık plan paywall'da
# Sprint 2 bayrakları (CONTRACTS_V2.md Sprint 2)
FEATURE_PRODUCT_LINKS=false               # ürün/uzman bağlantıları + tıklama takibi (Ç4: ücret/komisyon kapalı)
FEATURE_GLOW_UP=true                      # "iyileşmiş halin" görseli; yalnız "false" kapatır
FEATURE_TRYON_COMBO=true                  # saç + sakal (+ renk) tek görselde; yalnız "false" kapatır
# Sanal deneme v2 (lib/config/tryon.ts): sağlayıcı yarıştırılmaz; model adı env'de (kullanılabilirlik uydurulmaz)
TRYON_IMAGE_MODEL=                        # boş = GEMINI_IMAGE_MODEL > gemini-3.1-flash-lite-image (PLAN 5c önerisi: gemini-3.1-flash-image)
TRYON_QC=on                               # on | off — Claude kalite kontrolü (R2-C10/3); off yalnız geliştirme
TRYON_QC_MODEL=claude-opus-5-5
TRYON_QC_EFFORT=low                       # low | medium | high
TRYON_QC_MAX_REGEN=2                      # 0–3; geçmeyen görsel en çok bu kadar yeniden üretilir, yine geçmezse gösterilmez, hak düşmez
TRYON_WEIGHT_STYLE=1                      # mod başına kota ağırlığı 1–5 (deneme kotası AÇIK, KB §11.2)
TRYON_WEIGHT_COMBO=1
TRYON_WEIGHT_GLOW_UP=1
# v2 ürün fiyatları (KDV dahil TL, tam sayı); boş = yer tutucu (lib/config/plans.ts PRODUCT_PRICE_PLACEHOLDERS)
PRODUCT_PRICE_ONE_TIME_REPORT_TRY=
PRODUCT_PROMO_PRICE_ONE_TIME_REPORT_TRY=
PRODUCT_PRICE_WEEKLY_TRY=
PRODUCT_PROMO_PRICE_WEEKLY_TRY=
PRODUCT_PRICE_MONTHLY_TRY=
PRODUCT_PROMO_PRICE_MONTHLY_TRY=
PRODUCT_PRICE_YEARLY_TRY=
PRODUCT_PROMO_PRICE_YEARLY_TRY=
OFFER_DURATION_HOURS=24                   # süreli teklif (P#18); süre AÇIK
OFFER_PROMO_PRODUCT=one_time_report       # tanıtım fiyatının uygulandığı ürün (AÇIK; lib/billing/offer.ts)
OFFER_REGULAR_PRODUCT=one_time_report     # süre bitince satılan ürün kimliği
IYZICO_PRODUCT_ONE_TIME_REPORT_REF=
IYZICO_PRODUCT_ONE_TIME_REPORT_PROMO_REF=
IYZICO_PLAN_WEEKLY_PROMO_REF=
IYZICO_PLAN_MONTHLY_PROMO_REF=
IYZICO_PLAN_YEARLY_PROMO_REF=
ADMIN_EMAILS=
PHYSICIAN_EMAILS=                         # Doktor kuyruğunu (/admin/doctor, /api/doctor/review) açan hekim hesapları; ADMIN_EMAILS yetmez (KB Ç3, AUP)
KVKK_REQUEST_ADDRESS=                     # KVKK m.11 tam kopya başvuru adresi; onaylanana kadar boş (dışa aktarmada not yok)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
RESEND_API_KEY=                           # GİZLİ
EMAIL_FROM=                               # isteğe bağlı: "Aura <no-reply@alan-adi>"
REFERRAL_SIGNING_SECRET=                  # GİZLİ: partner durum linklerinin imzası (openssl rand -hex 32)
# Sentry build'de kaynak haritası yüklemesi (isteğe bağlı; yoksa atlanır)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=                        # GİZLİ, yalnız CI/build
# RevenueCat (mobil uygulama içi satın alma; SPEC 15.4)
REVENUECAT_SECRET_API_KEY=                # GİZLİ, yalnız sunucu (REST v1 abone sorgusu)
REVENUECAT_WEBHOOK_SECRET=                # GİZLİ: RevenueCat panelinde webhook Authorization değeri
REVENUECAT_PRODUCT_ONE_TIME_REPORT_ID=    # AÇIK (kurucu): App Store / Play tek seferlik rapor ürün kimliği (NON_RENEWING_PURCHASE → purchases)
REVENUECAT_PRODUCT_ONE_TIME_REPORT_PROMO_ID= # AÇIK: tanıtım fiyatlı tek seferlik rapor ürünü (varsa)
OPS_TRYON_BROKEN_RATE_ALERT=              # /admin "Bozuk görünüyor" vurgu eşiği 0–1 (varsayılan 0.05, CLAUDE NOTU)

# Affedici seri (PLAN Faz 6 ÖNERİ; lib/config/routine.ts): haftada dinlenme günü 0–3, ayda dondurma 0–4 (yer tutucu)
ROUTINE_REST_DAYS_PER_WEEK=1
ROUTINE_FREEZES_PER_MONTH=1
