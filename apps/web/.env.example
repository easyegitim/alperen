# Öğrenmen web uygulaması ortam değişkenleri (kopyala: cp .env.example .env.local).
# Gerçek değerleri .env.local içine yaz; .env.local git'e girmez.

# Supabase projesinin adresi ve herkese açık (anon) anahtarı. Yerel: `supabase start` çıktısı.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Uygulamanın dışarıdan görünen adresi (e-posta bağlantısı ve Google dönüşü için). Boşsa istek başlıklarından türetilir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web-push VAPID herkese açık anahtarı (base64url). Gönderim apps/worker'da; özel anahtar burada yok.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Koç sohbeti (yalnız sunucu; NEXT_PUBLIC_ öneki YOK, tarayıcıya gitmez) ---
# Koç turunun sunucu Postgres bağlantısı (yalnız src/server/chat; her sorgu oturumdaki öğrenciyle kapsanır).
# Boşsa Koç "kullanılamıyor" gösterir. Depo genelindeki OGRENMEN_DATABASE_URL (kurucunun yönetici adresi; yedek ve
# test betikleri) bilerek OKUNMAZ: buraya asla o adresi kopyalama.
# KAPALI BAŞARISIZLIK: bağlantı rolü RLS'i aşıyorsa (postgres, service_role, süper kullanıcı, BYPASSRLS) üretimde koç
# açılmaz (503). Okumalar henüz kullanıcı JWT'siyle değil (bkz. src/server/chat/pg-store.ts "Bilinen sapma"); hedef
# yalnız EXECUTE yetkili `ogrenmen_web_coach` rolü + SECURITY DEFINER koç RPC'leri. O gelene dek koç yalnız yerelde,
# aşağıdaki bayrakla açılır.
# KİP: oturum kipi (doğrudan bağlantı ya da Supavisor :5432). İşlem kipi (:6543) tur kilidini (danışma kilidi) taşımaz.
OGRENMEN_WEB_COACH_DATABASE_URL=
# Yalnız yerel geliştirme: RLS'i aşan rolle koçu açar (1). Üretimde (NODE_ENV=production) yok sayılır.
OGRENMEN_WEB_COACH_TRUSTED_DEV=
# Sorgu havuzu ve tur kilidi havuzu (her süren koç turu bir kilit bağlantısı tutar). Boşsa 5 ve 10.
OGRENMEN_CHAT_POOL_MAX=
OGRENMEN_CHAT_LOCK_POOL_MAX=
# fake: ağsız deterministik LLM (yerel geliştirme/E2E). Boş: gerçek Anthropic (ANTHROPIC_API_KEY ortamdan okunur).
OGRENMEN_LLM=fake
# Veritabanısız yerel geliştirme: memory (yalnız OGRENMEN_LLM=fake ile açılır; süreç içi, kalıcı değil).
OGRENMEN_CHAT_STORE=
ANTHROPIC_API_KEY=
