# Öğrenmen web uygulaması ortam değişkenleri (kopyala: cp .env.example .env.local).
# Gerçek değerleri .env.local içine yaz; .env.local git'e girmez. ANTHROPIC anahtarı burada YOK (P1: yalnızca apps/worker).

# Supabase projesinin adresi ve herkese açık (anon) anahtarı. Yerel: `supabase start` çıktısı.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Uygulamanın dışarıdan görünen adresi (e-posta bağlantısı ve Google dönüşü için). Boşsa istek başlıklarından türetilir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web-push VAPID herkese açık anahtarı (base64url). Gönderim apps/worker'da; özel anahtar burada yok.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
