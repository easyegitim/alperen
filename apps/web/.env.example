# Öğrenmen web uygulaması ortam değişkenleri (kopyala: cp .env.example .env.local).
# Gerçek değerleri .env.local içine yaz; .env.local git'e girmez.

# Supabase projesinin adresi ve herkese açık (anon) anahtarı. Yerel: `supabase start` çıktısı.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Uygulamanın dışarıdan görünen adresi (e-posta bağlantısı ve Google dönüşü için). Boşsa istek başlıklarından türetilir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Realtime (src/lib/live.ts): boş/on = abone ol, off = yalnız yoklama (Realtime'sız Supabase, yerel köprü)
NEXT_PUBLIC_SUPABASE_REALTIME=

# Web-push VAPID herkese açık anahtarı (base64url). Gönderim apps/worker'da; özel anahtar burada yok.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Koç sohbeti (yalnız sunucu; NEXT_PUBLIC_ öneki YOK, tarayıcıya gitmez) ---
# Koç yalnız kullanıcının JWT'siyle çalışır (Supabase SSR istemcisi + koç RPC'leri, supabase/migrations/0028); web'de
# service_role ve veritabanı adresi YOKTUR. Model çıktısı, llm_calls defteri, hafıza yazımı ve eğitmen yönlendirmesi
# sunucu jetonu ister: jetonu bu anahtar basar. Değer, göçün ürettiği secure.server_keys satırıdır (kurucu bir kez okur:
#   select secret from secure.server_keys where name = 'web_coach';
# ). Boşsa Koç "kullanılamıyor" gösterir. Anahtar sızarsa satırı yenile (update … set secret = …, rotated_at = now())
# ve buraya yeni değeri yaz.
OGRENMEN_WEB_COACH_KEY=
# fake: ağsız deterministik LLM (yerel geliştirme/E2E). Boş: gerçek Anthropic (ANTHROPIC_API_KEY ortamdan okunur).
OGRENMEN_LLM=fake
# Veritabanısız yerel geliştirme: memory (yalnız OGRENMEN_LLM=fake ile açılır; süreç içi, kalıcı değil).
OGRENMEN_CHAT_STORE=
ANTHROPIC_API_KEY=
