# apps/worker ortam değişkenleri. Gerçek değerler Fly secrets / yerel .env.local; bu dosyaya sır yazılmaz.

# --- Zorunlu ---
# Service role (RLS atlanır) ya da doğrudan Postgres bağlantısı; yalnız worker kullanır. Supabase'de doğrudan (5432) bağlantı,
# PgBouncer işlem havuzu DEĞİL (LISTEN/NOTIFY ve advisory lock gerekir).
DATABASE_URL=postgresql://ogrenmen:ogrenmen@127.0.0.1:5432/ogrenmen

# --- Süreç ---
# worker | pdf | all (komut satırı --process=... önceliklidir)
WORKER_PROCESS=all
# Üretimde 'pgboss' olmalı: SQL tarafındaki public.enqueue_job() şemayı sabit kullanır (yalnız testlerde başka şema).
PGBOSS_SCHEMA=pgboss
PGBOSS_POOL_MAX=8
DB_POOL_MAX=8
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
# auto: runtime_flags.cron_owner = pg_cron ise zamanlama kurulmaz | on | off
WORKER_SCHEDULES=auto
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000
# Başlangıç denetimleri (src/startup-checks.ts): strict = düşerse çıkış 78 | warn = sağlık 'degraded' ile sürer | off
WORKER_STARTUP_CHECKS=strict
# auto: enqueue_job sahibinin pgboss yetkisi eksikse (ve bu bağlantı verebiliyorsa) USAGE/SELECT/INSERT verir | off
WORKER_PGBOSS_GRANT=auto
WORKER_STARTUP_EXIT_DELAY_MS=2000
# secure.job_outbox → pg-boss aktarımı (outbox.drain) aralığı; 0 zamanlayıcıyı kapatır
OUTBOX_DRAIN_INTERVAL_MS=30000

# --- LLM (packages/llm) ---
# fake: ağsız deterministik istemci (geliştirme/test); boş: gerçek Anthropic
OGRENMEN_LLM=
ANTHROPIC_API_KEY=
# Belge figürleri: boş/auto (varsayılan: gerçek anahtarla code_execution = Anthropic konteyneri + Files API; sahte LLM'de
# yerel) | code_execution | local (yalnız açıkça: model kodu worker'da OS yalıtımında çalışır; setpriv + unshare ve
# kullanıcı ad alanı gerekir, yoksa figür çizilmez)
OGRENMEN_FIGURES=

# --- Supabase Storage (service key) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_DOCUMENTS=documents

# --- Web-push (VAPID); üçü birlikte ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@ogrenmen.example

# --- E-posta (Resend; email.send). Anahtar yoksa kuru çalışma: ileti günlüğe, teslim payload.delivery.email = dry ---
RESEND_API_KEY=
EMAIL_FROM=Öğrenmen <bildirim@ogrenmen.example>
# E-postadaki "Uygulamada aç" bağlantısının kökü
OGRENMEN_SITE_URL=
# template: haftalık bildirim metninde Haiku (notification_copy) kapalı
OGRENMEN_NOTIFICATION_COPY=

# --- PDF ---
# Boşsa Playwright'ın kurulu Chromium'u (PLAYWRIGHT_BROWSERS_PATH, yerelde /opt/pw-browsers)
PDF_CHROMIUM_PATH=
PDF_CONCURRENCY=2

# Ders medya servisi (pipelines/ders service.py; P5 lesson.* işleri). Yerelde: python3 -I pipelines/ders/src/ogrenmen_ders/service.py
# (GROQ_API_KEY yoksa servis tarafında OGRENMEN_STT=fake). Belirteç tanımlıysa servis tarafında da aynı değer olmalı.
LESSON_SERVICE_URL=http://127.0.0.1:8711
LESSON_SERVICE_TOKEN=
