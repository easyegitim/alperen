SUPABASE_ANON_KEY=sahte-anon
SUPABASE_BOT_JWT=sahte.bot.jwt
GEMINI_PAID_KEY=
GEMINI_FREE_KEY=
GROQ_KEY=
OPENROUTER_KEY=
CF_AI_TOKEN=
CF_ACCOUNT_ID=
ADMIN_CHAT_ID=0
