# Yerel geliştirme gizleri (kopyala: cp .dev.vars.example .dev.vars — .dev.vars git'e girmez).
# Değerler bilerek sahtedir; gerçek anahtarlar yalnız `wrangler secret put` ile verilir.
TELEGRAM_BOT_TOKEN=000000:sahte-yerel-token
TELEGRAM_WEBHOOK_SECRET=yerel-webhook-gizi
WEBHOOK_SECRET_PATH=yerel-gizli-yol
