{
  "name": "@ogrenmen/worker",
  "version": "0.1.0",
  "description": "Öğrenmen iş işçisi: pg-boss tüketicisi, Anthropic geçidi, Playwright PDF, web-push, zamanlayıcı",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "dev:pdf": "tsx watch src/index.ts --process=pdf"
  },
  "dependencies": {
    "@ogrenmen/contracts": "workspace:*",
    "@ogrenmen/llm": "workspace:*",
    "@ogrenmen/prompts": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "playwright-core": "1.56.1",
    "tsx": "^4.20.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.10.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "eslint": "9.39.5",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vitest": "2.1.9"
  }
}
