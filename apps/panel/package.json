{
  "name": "@ogrenmen/panel",
  "version": "0.1.0",
  "description": "Öğrenmen eğitmen paneli — Next.js statik export (M11)",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "postinstall": "node scripts/sync-ds.mjs && node scripts/tokens-to-css.mjs",
    "sync:ds": "node scripts/sync-ds.mjs && node scripts/tokens-to-css.mjs",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "dev:mock": "NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_DATA_SOURCE=mock next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "node scripts/serve-out.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ogrenmen/contracts": "file:../../packages/contracts",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.30.1",
    "vitest": "2.1.9"
  }
}
