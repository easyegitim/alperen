{
  "$schema": "./schemas/models.schema.json",
  "verified_at": "2026-10-19",
  "currency": "USD",
  "note": "Fiyatlar 1M token başına USD; 0 = ücretsiz katman. Ücretsiz katmanda gönderilen veri ürün eğitiminde kullanılabilir: öğrenci metni içeren 'chat' zincirinde gemini-free yalnız yedek ve her zaman temizlenmiş metinle; aydınlatma metni bunu yazar. Limitler sık değişir; gerçek limit sağlayıcı panelinde.",
  "providers": {
    "gemini-paid": {
      "kind": "gemini",
      "base": "https://generativelanguage.googleapis.com/v1beta",
      "key_env": "GEMINI_PAID_KEY",
      "tier": "paid",
      "trains_on_data": false
    },
    "gemini-free": {
      "kind": "gemini",
      "base": "https://generativelanguage.googleapis.com/v1beta",
      "key_env": "GEMINI_FREE_KEY",
      "tier": "free",
      "rpd": 1000,
      "trains_on_data": true
    },
    "groq": {
      "kind": "openai-compatible",
      "base": "https://api.groq.com/openai/v1",
      "key_env": "GROQ_KEY",
      "tier": "free",
      "rpd": 1000
    },
    "cf-ai": {
      "kind": "workers-ai",
      "binding": "AI",
      "rest_base": "https://api.cloudflare.com/client/v4/accounts/{account}/ai/run",
      "key_env": "CF_AI_TOKEN",
      "tier": "free",
      "neurons_per_day": 10000
    },
    "openrouter": {
      "kind": "openai-compatible",
      "base": "https://openrouter.ai/api/v1",
      "key_env": "OPENROUTER_KEY",
      "tier": "free",
      "rpd": 50
    },
    "anthropic": {
      "kind": "anthropic",
      "base": "https://api.anthropic.com/v1",
      "key_env": "ANTHROPIC_KEY",
      "tier": "paid",
      "enabled": false
    },
    "fake": {
      "kind": "fake",
      "tier": "free"
    }
  },
  "models": {
