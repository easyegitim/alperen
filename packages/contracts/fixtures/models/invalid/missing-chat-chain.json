      "provider": "gemini-paid",
      "in_per_m": 0.1,
      "out_per_m": 0.4,
      "batch_discount": 0.5,
      "ctx": 1000000,
      "structured": true
    },
    "gemini-2.5-flash": {
      "provider": "gemini-paid",
      "in_per_m": 0.3,
      "out_per_m": 2.5,
      "batch_discount": 0.5,
      "ctx": 1000000,
      "structured": true,
      "vision": true,
