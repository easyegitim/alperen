{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/diagnostic-test.json",
  "title": "DiagnosticTest",
  "description": "Teşhis testi madde listesi (diagnostic/items.json): 15–20 madde, sabit sıra, her madde 4 şık. Doğru şık alanı (correct) TANIMSIZDIR ve additionalProperties:false olduğundan anahtar bu dosyaya sızamaz.",
  "x-version": "1.0",
  "type": "array",
  "minItems": 15,
  "maxItems": 20,
  "items": {
    "$ref": "#/$defs/item"
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "skill_ids",
        "difficulty",
        "kind",
        "stem",
        "figure",
        "options"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^DIAG-[0-9]{4}\\.[0-9]+-[0-9]{2}$",
          "examples": [
            "DIAG-2026.1-07"
          ]
        },
        "skill_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "common.json#/$defs/skillId"
          }
        },
        "difficulty": {
          "$ref": "common.json#/$defs/probability"
        },
        "kind": {
          "const": "mcq",
          "description": "Teşhis maddeleri A–D şıklıdır"
        },
        "stem": {
          "type": "string",
          "minLength": 10,
          "maxLength": 900
        },
        "stem_values": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          }
        },
        "figure": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/figure"
            }
          ]
        },
        "options": {
          "$ref": "question-item.json#/properties/options"
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "png_path",
        "alt_text"
      ],
      "description": "Önceden render edilmiş şekil (diagnostic/figures/*.png + üreten .py, seed=2026)",
      "properties": {
        "tool": {
          "enum": [
            "matplotlib",
            "svg",
            "template"
          ]
        },
        "png_path": {
          "type": "string",
          "pattern": "^figures/[a-z0-9-]+\\.png$"
        },
        "source_path": {
          "type": "string",
          "pattern": "^figures/[a-z0-9-]+\\.py$"
        },
        "alt_text": {
          "type": "string",
          "minLength": 15,
          "maxLength": 400,
          "description": "Şekli kelimelerle anlatır (Telegram altyazısı)"
        }
      }
    }
  }
}
