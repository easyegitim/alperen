{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/template-params.json",
  "title": "TemplateParams",
  "description": "Parametrik şablon varyantının parametreleri (question-item.template ile aynı biçim: {id, params}); seed ile aynı varyant yeniden üretilir. Değerler: sayı, metin, mantıksal, null, bunların düz dizisi ya da bir düzey düz nesne (ör. {\"kesir1\": {\"pay\": 1, \"payda\": 2}}); iki düzey iç içe nesne düşer.",
  "x-version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "params"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "examples": [
        "kesir-modeli-toplama"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "params": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    }
  },
  "$defs": {
    "scalar": {
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },
    "leaf": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 12,
          "propertyNames": {
            "pattern": "^[a-z_][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/leaf"
          }
        }
      ]
    }
  }
}
