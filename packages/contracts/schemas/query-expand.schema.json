{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/query-expand.json",
  "title": "QueryExpand",
  "description": "Kitap araştırma sorusunun 3–5 arama sorgusuna genişletilmesi (zincir query_expand).",
  "x-version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queries"
  ],
  "properties": {
    "queries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200
      }
    }
  }
}
