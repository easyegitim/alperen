{
  "title": "AnswerKey",
  "description": "Cevap anahtarı: yalnız pipeline/seed ↔ register_answer_key. Worker bu şemayı içe almaz; secure.answer_keys satırının sözleşmesi.",
  "type": "object",
  "required": [
    "question_id",
    "solution",
    "sympy_status"
  ],
  "properties": {
    "question_id": {
      "type": "string"
    },
    "correct_option": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "type": "string"
    },
    "numeric_value": {
      "type": "string",
      "description": "SymPy string: '7/8', '2*sqrt(3)'"
    },
    "numeric_tolerance": {
      "type": "number",
      "minimum": 0
    },
    "canonical_expr": {
      "type": "string",
      "description": "sympy.sympify edilebilir ifade; stem_values ile çözülür"
    },
    "solution": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "description": "Adım adım çözüm; doğrudan modda reveal_solution bunu döner"
    },
    "sympy_status": {
      "enum": [
        "verified",
        "failed",
        "not_applicable"
      ],
      "type": "string"
    },
    "sympy_report": {
      "type": "object",
      "properties": {
        "expr": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "matched_option": {
          "type": "string",
          "nullable": true
        },
        "note": {
          "type": "string"
        }
      },
      "propertyOrdering": [
        "expr",
        "value",
        "matched_option",
        "note"
      ]
    }
  },
  "propertyOrdering": [
    "question_id",
    "correct_option",
    "numeric_value",
    "numeric_tolerance",
    "canonical_expr",
    "solution",
    "sympy_status",
    "sympy_report"
  ]
}
