{
  "title": "DiagnosticTest",
  "description": "Teşhis testi madde listesi (diagnostic/items.json): 15–20 madde, sabit sıra, her madde 4 şık. Doğru şık alanı (correct) TANIMSIZDIR ve additionalProperties:false olduğundan anahtar bu dosyaya sızamaz.",
  "type": "array",
  "minItems": 15,
  "maxItems": 20,
  "items": {
    "type": "object",
    "required": [
      "code",
      "skill_ids",
      "difficulty",
      "kind",
      "stem",
      "figure",
      "options"
    ],
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^DIAG-[0-9]{4}\\.[0-9]+-[0-9]{2}$"
      },
      "skill_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "string",
          "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
        }
      },
      "difficulty": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "kind": {
        "enum": [
          "mcq"
        ],
        "description": "Teşhis maddeleri A–D şıklıdır",
        "type": "string"
      },
      "stem": {
        "type": "string",
        "minLength": 10,
        "maxLength": 900
      },
      "stem_values": {
        "type": "object"
      },
      "figure": {
        "type": "object",
        "required": [
          "tool",
          "png_path",
          "alt_text"
        ],
        "description": "Önceden render edilmiş şekil (diagnostic/figures/*.png + üreten .py, seed=2026)",
        "properties": {
          "tool": {
            "enum": [
              "matplotlib",
              "svg",
              "template"
            ],
            "type": "string"
          },
          "png_path": {
            "type": "string",
            "pattern": "^figures/[a-z0-9-]+\\.png$"
          },
          "source_path": {
            "type": "string",
            "pattern": "^figures/[a-z0-9-]+\\.py$"
          },
          "alt_text": {
            "type": "string",
            "minLength": 15,
            "maxLength": 400,
            "description": "Şekli kelimelerle anlatır (Telegram altyazısı)"
          }
        },
        "propertyOrdering": [
          "tool",
          "png_path",
          "source_path",
          "alt_text"
        ],
        "nullable": true
      },
      "options": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "description": "Tam dört şık, anahtarlar sırayla A, B, C, D (yinelenen, eksik ya da sırası bozuk anahtar düşer; Telegram A·B·C·D düğmeleri ve grade_attempt aynı sırayı varsayar). En az iki şık misconception_tag=null taşır (doğru şık + en az bir etiketsiz çeldirici).",
        "items": {
          "type": "object",
          "required": [
            "key",
            "text",
            "misconception_tag"
          ],
          "properties": {
            "key": {
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ],
              "type": "string"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "misconception_tag": {
              "type": "string",
              "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
              "description": "Yanlış şıkkın kodladığı yanılgı. DOĞRU ŞIK BU DİZİDEN ÇIKARILAMAZ: doğru şık null taşır VE en az bir çeldirici de null taşır (en az iki null zorunlu); LLM ve öğrenci yolu şıkları app.strip_tags ile etiketsiz görür.",
              "nullable": true
            }
          },
          "propertyOrdering": [
            "key",
            "text",
            "misconception_tag"
          ]
        }
      }
    },
    "propertyOrdering": [
      "code",
      "skill_ids",
      "difficulty",
      "kind",
      "stem",
      "stem_values",
      "figure",
      "options"
    ]
  }
}
