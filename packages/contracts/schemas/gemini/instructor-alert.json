{
  "title": "InstructorAlert",
  "description": "Eğitmen paneli alarmı (instructor_alerts). Tek cümle, yargısız; şiddet panelde kelimeyle gösterilir.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "severity",
    "student_ref",
    "detail",
    "since",
    "ref"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ],
      "type": "string"
    },
    "kind": {
      "enum": [
        "unanswered",
        "silent",
        "morale",
        "deadline",
        "response",
        "ops"
      ],
      "type": "string"
    },
    "severity": {
      "enum": [
        "danger",
        "warning",
        "neutral"
      ],
      "description": "Panelde kelimeyle: Acil / Dikkat / Bilgi",
      "type": "string"
    },
    "student_ref": {
      "type": "string",
      "pattern": "^s_[a-z2-7]{12}$",
      "description": "students.public_ref; ad ve uuid asla",
      "nullable": true
    },
    "staff_ref": {
      "type": "string",
      "nullable": true
    },
    "detail": {
      "type": "string",
      "maxLength": 240,
      "description": "Tek cümle; cevapsız soruda sorunun kendisi tırnak içinde; yargı yok ('göstergesi düştü')"
    },
    "since": {
      "type": "string",
      "format": "date-time"
    },
    "ref": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "integer"
        },
        "fact_id": {
          "type": "integer"
        },
        "escalation_id": {
          "type": "string"
        },
        "lesson_id": {
          "type": "string"
        },
        "chat_id": {
          "type": "integer",
          "description": "ops alarmları (grup başına tekil)"
        },
        "source_id": {
          "type": "string",
          "description": "ops: exam_sources OCR hatası"
        }
      },
      "propertyOrdering": [
        "message_id",
        "fact_id",
        "escalation_id",
        "lesson_id",
        "chat_id",
        "source_id"
      ]
    }
  },
  "propertyOrdering": [
    "schema_version",
    "kind",
    "severity",
    "student_ref",
    "staff_ref",
    "detail",
    "since",
    "ref"
  ]
}
