{
  "title": "NightlyFactsOutput",
  "description": "Gece olgu çıkarımının öğrenci × gün çıktısı (Batch; zincir nightly_facts).",
  "type": "object",
  "required": [
    "schema_version",
    "day",
    "student_ref",
    "facts",
    "is_question_message_ids",
    "answered_question_message_ids"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ],
      "type": "string"
    },
    "day": {
      "type": "string"
    },
    "student_ref": {
      "type": "string",
      "pattern": "^s_[a-z2-7]{12}$",
      "description": "students.public_ref; ad ve uuid asla"
    },
    "facts": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "title": "MemoryFact",
        "description": "Gece olgu çıkarımının tek olgusu (memory_facts satırı). Kaynak mesaj numarası zorunlu; ad içermez.",
        "type": "object",
        "required": [
          "schema_version",
          "student_ref",
          "kind",
          "text",
          "source_message_ids",
          "confidence",
          "requires_approval"
        ],
        "properties": {
          "schema_version": {
            "enum": [
              "1.0"
            ],
            "type": "string"
          },
          "student_ref": {
            "type": "string",
            "pattern": "^s_[a-z2-7]{12}$",
            "description": "students.public_ref; ad ve uuid asla"
          },
          "kind": {
            "enum": [
              "promise",
              "deadline",
              "unanswered_question",
              "morale",
              "topic_asked",
              "preference",
              "instructor_fact",
              "other"
            ],
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 8,
            "maxLength": 300,
            "description": "İsim yok; 'öğrenci' veya 'eğitmen' der; üçüncü tekil"
          },
          "source_message_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "integer"
            },
            "description": "messages.id — kaynak zorunlu; günün mesajları arasında olmalı (pipeline doğrular)"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "valid_until": {
            "type": "string",
            "nullable": true
          },
          "morale_signal": {
            "type": "integer",
            "minimum": -2,
            "maximum": 2,
            "nullable": true
          },
          "requires_approval": {
            "type": "boolean",
            "description": "not/devamsızlık/puan/ödeme içeriyorsa true; bot approved olmadan kullanmaz"
          },
          "skill_id": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$",
            "nullable": true
          }
        },
        "propertyOrdering": [
          "schema_version",
          "student_ref",
          "kind",
          "text",
          "source_message_ids",
          "confidence",
          "valid_until",
          "morale_signal",
          "requires_approval",
          "skill_id"
        ]
      }
    },
    "is_question_message_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "answered_question_message_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "modality": {
          "enum": [
            "visual",
            "verbal",
            "mixed"
          ],
          "type": "string"
        },
        "explanation_notes": {
          "type": "string",
          "maxLength": 200
        },
        "active_hours": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          }
        }
      },
      "propertyOrdering": [
        "modality",
        "explanation_notes",
        "active_hours"
      ]
    }
  },
  "propertyOrdering": [
    "schema_version",
    "day",
    "student_ref",
    "facts",
    "is_question_message_ids",
    "answered_question_message_ids",
    "preferences"
  ]
}
