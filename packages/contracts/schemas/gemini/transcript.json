{
  "title": "Transcript",
  "description": "Ders transkripti (transcribe/diarize sahteleri ve transcripts/<id>.jsonl): konuşmacı etiketli, isimsiz bölümler. Tek bölüm transcript#/$defs/segment ile doğrulanır.",
  "type": "object",
  "required": [
    "segments"
  ],
  "properties": {
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "t",
          "speaker",
          "text"
        ],
        "properties": {
          "t": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
            "description": "HH:MM:SS"
          },
          "t_end": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
            "description": "HH:MM:SS"
          },
          "speaker": {
            "enum": [
              "ÖĞRENCİ",
              "EĞİTMEN"
            ],
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "propertyOrdering": [
          "t",
          "t_end",
          "speaker",
          "text"
        ]
      }
    }
  },
  "propertyOrdering": [
    "segments"
  ]
}
