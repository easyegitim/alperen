{
  "title": "ExamItem",
  "description": "Sınav arşivinden OCR ile çıkarılmış tek soru (exam_items). ocr_text hiçbir öğrenci çıktısına kopyalanmaz.",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "item_no",
    "topic",
    "kind",
    "year",
    "ocr_text"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ],
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "item_no": {
      "type": "integer",
      "minimum": 1
    },
    "topic": {
      "type": "string",
      "maxLength": 120
    },
    "kind": {
      "enum": [
        "proof",
        "calc",
        "mc",
        "other"
      ],
      "type": "string"
    },
    "points": {
      "type": "number",
      "minimum": 0,
      "nullable": true
    },
    "year": {
      "type": "integer"
    },
    "term": {
      "enum": [
        "vize",
        "final",
        "but",
        "deneme",
        "osym",
        "diger"
      ],
      "type": "string",
      "nullable": true
    },
    "instructor_alias": {
      "type": "string",
      "pattern": "^hoca-[A-Z]$",
      "nullable": true
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$",
      "nullable": true
    },
    "ocr_text": {
      "type": "string",
      "description": "Yalnız eğitmen arşivi ve kümeleme; hiçbir öğrenci çıktısına kopyalanmaz"
    },
    "ocr_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "propertyOrdering": [
    "schema_version",
    "source_id",
    "item_no",
    "topic",
    "kind",
    "points",
    "year",
    "term",
    "instructor_alias",
    "skill_id",
    "ocr_text",
    "ocr_confidence"
  ]
}
