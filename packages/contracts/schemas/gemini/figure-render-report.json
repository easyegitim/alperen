{
  "title": "FigureRenderReport",
  "description": "Şekil denetim raporu (zincir vision_check): PNG + stem_values karşılaştırması {matches_stem, mismatches, notes}; isteğe bağlı olarak render adımının boyut/durum özeti. mismatch → attempts+1 ve 'kodu düzelt' ile yeniden üretim.",
  "type": "object",
  "required": [
    "matches_stem",
    "mismatches"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ],
      "type": "string"
    },
    "figure_id": {
      "type": "string"
    },
    "matches_stem": {
      "type": "boolean",
      "description": "Şekil soru kökündeki değerlerle uyuşuyor mu"
    },
    "status": {
      "enum": [
        "match",
        "mismatch"
      ],
      "description": "figures.vision_status karşılığı; matches_stem ile tutarlı olmalı",
      "type": "string"
    },
    "mismatches": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "stem_values anahtarı ya da şekil öğesi"
              },
              "expected": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "nullable": true
              },
              "observed": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "nullable": true
              },
              "note": {
                "type": "string",
                "maxLength": 300
              }
            },
            "propertyOrdering": [
              "field",
              "expected",
              "observed",
              "note"
            ]
          }
        ]
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 600,
      "nullable": true
    },
    "render": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "failed",
            "size_mismatch",
            "blank",
            "skipped"
          ],
          "type": "string"
        },
        "tool": {
          "enum": [
            "matplotlib",
            "svg",
            "tikz",
            "vega-lite",
            "schemdraw",
            "rdkit",
            "graphviz",
            "latex",
            "template"
          ],
          "type": "string"
        },
        "width_px": {
          "type": "integer",
          "minimum": 0
        },
        "height_px": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "pixel_variance": {
          "type": "number",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "log": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "propertyOrdering": [
        "status",
        "tool",
        "width_px",
        "height_px",
        "bytes",
        "pixel_variance",
        "duration_ms",
        "log"
      ]
    }
  },
  "propertyOrdering": [
    "schema_version",
    "figure_id",
    "matches_stem",
    "status",
    "mismatches",
    "notes",
    "render"
  ]
}
