{
  "title": "WeeklySummary",
  "description": "Haftalık öğrenci özeti (Katman 3): üçüncü tekil, isimsiz; metrikler SQL/Python'dan, LLM yalnız metni yazar.",
  "type": "object",
  "required": [
    "schema_version",
    "student_ref",
    "week_start",
    "body",
    "metrics",
    "facts_used"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ],
      "type": "string"
    },
    "student_ref": {
      "type": "string",
      "pattern": "^s_[a-z2-7]{12}$",
      "description": "students.public_ref; ad ve uuid asla"
    },
    "week_start": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "maxLength": 600,
      "description": "3–6 cümle, üçüncü tekil, isimsiz: ne çalıştı, nerede takıldı, ne söz verdi, moral"
    },
    "metrics": {
      "type": "object",
      "required": [
        "messages",
        "questions_solved",
        "accuracy",
        "active_days",
        "open_misconceptions",
        "unanswered_questions",
        "morale_trend"
      ],
      "properties": {
        "messages": {
          "type": "integer"
        },
        "questions_solved": {
          "type": "integer"
        },
        "accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "nullable": true
        },
        "active_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "open_misconceptions": {
          "type": "integer"
        },
        "unanswered_questions": {
          "type": "integer"
        },
        "morale_trend": {
          "enum": [
            "up",
            "flat",
            "down",
            "unknown"
          ],
          "type": "string"
        },
        "mastery_deltas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "skill_id",
              "delta"
            ],
            "properties": {
              "skill_id": {
                "type": "string",
                "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
              },
              "delta": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "reliable": {
                "type": "boolean"
              }
            },
            "propertyOrdering": [
              "skill_id",
              "delta",
              "reliable"
            ]
          }
        }
      },
      "propertyOrdering": [
        "messages",
        "questions_solved",
        "accuracy",
        "active_days",
        "open_misconceptions",
        "unanswered_questions",
        "morale_trend",
        "mastery_deltas"
      ]
    },
    "facts_used": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "next_week_focus": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
      }
    }
  },
  "propertyOrdering": [
    "schema_version",
    "student_ref",
    "week_start",
    "body",
    "metrics",
    "facts_used",
    "next_week_focus"
  ]
}
