{
  "title": "ExamPriorityPlan",
  "description": "Kalem (b) çıktısı: geçmiş sınavların sıklık analizine göre öncelikler. Tahmin değildir; soru metni taşımaz.",
  "type": "object",
  "required": [
    "schema_version",
    "course_code",
    "period",
    "title",
    "years_total",
    "rows",
    "others",
    "evidence_count",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ],
      "type": "string"
    },
    "course_code": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "title": {
      "enum": [
        "Sıklık analizine göre öncelikler"
      ],
      "type": "string"
    },
    "years_total": {
      "type": "integer",
      "minimum": 2
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "topic",
          "kind",
          "hits",
          "years",
          "points_text",
          "evidence_count",
          "evidence_item_ids",
          "syllabus_alignment"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "topic": {
            "type": "string",
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "ispat",
              "hesap",
              "çoktan seçmeli",
              "diğer"
            ],
            "type": "string"
          },
          "skill_id": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$",
            "nullable": true
          },
          "hits": {
            "type": "integer",
            "minimum": 1
          },
          "years": {
            "type": "integer",
            "minimum": 1
          },
          "points_text": {
            "type": "string",
            "pattern": "^≈[0-9]+ puan$"
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 1
          },
          "evidence_item_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Eğitmen arşivine bağlantı; soru metni yok"
          },
          "syllabus_alignment": {
            "enum": [
              "covered_and_asked",
              "covered_never_asked",
              "asked_not_in_syllabus"
            ],
            "type": "string"
          },
          "variant_question_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "ÖZGÜN varyantlar (questions.source='llm', approved)"
          }
        },
        "propertyOrdering": [
          "rank",
          "topic",
          "kind",
          "skill_id",
          "hits",
          "years",
          "points_text",
          "evidence_count",
          "evidence_item_ids",
          "syllabus_alignment",
          "variant_question_ids"
        ]
      }
    },
    "others": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "uncovered_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "İzlencede var, hiç sorulmamış"
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "propertyOrdering": [
    "schema_version",
    "course_code",
    "period",
    "title",
    "years_total",
    "rows",
    "others",
    "uncovered_topics",
    "evidence_count",
    "generated_at"
  ]
}
