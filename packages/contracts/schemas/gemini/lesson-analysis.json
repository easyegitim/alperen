{
  "title": "LessonAnalysis",
  "description": "Ders videosu analizi (güçlü model, şema zorunlu). Her kazanım iddiası zaman damgalı alıntıyla gelir; adlar yerine ÖĞRENCİ/EĞİTMEN etiketi.",
  "type": "object",
  "required": [
    "schema_version",
    "lesson_ref",
    "student_ref",
    "skills",
    "questions",
    "hesitations",
    "misconceptions",
    "commitments",
    "talk",
    "previous_profile_check",
    "next_step",
    "model_notes"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ],
      "type": "string"
    },
    "lesson_ref": {
      "type": "string"
    },
    "student_ref": {
      "type": "string",
      "pattern": "^s_[a-z2-7]{12}$",
      "description": "students.public_ref; ad ve uuid asla"
    },
    "duration_min": {
      "type": "integer",
      "minimum": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill_id",
          "mastery_estimate",
          "confidence",
          "evidence"
        ],
        "properties": {
          "skill_id": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
          },
          "mastery_estimate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": [
                "speaker",
                "quote",
                "t"
              ],
              "properties": {
                "speaker": {
                  "enum": [
                    "ÖĞRENCİ",
                    "EĞİTMEN"
                  ],
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 300,
                  "description": "Alıntı; ad içermez"
                },
                "t": {
                  "type": "string",
                  "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
                  "description": "HH:MM:SS"
                },
                "t_end": {
                  "type": "string",
                  "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
                  "description": "HH:MM:SS"
                }
              },
              "propertyOrdering": [
                "speaker",
                "quote",
                "t",
                "t_end"
              ]
            },
            "description": "Kanıtsız kazanım geçersiz"
          }
        },
        "propertyOrdering": [
          "skill_id",
          "mastery_estimate",
          "confidence",
          "evidence"
        ]
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t",
          "quote"
        ],
        "properties": {
          "t": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
            "description": "HH:MM:SS"
          },
          "quote": {
            "type": "string",
            "maxLength": 300
          },
          "skill_id": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$",
            "nullable": true
          },
          "answered": {
            "type": "boolean"
          }
        },
        "propertyOrdering": [
          "t",
          "quote",
          "skill_id",
          "answered"
        ]
      }
    },
    "hesitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t",
          "kind"
        ],
        "properties": {
          "t": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
            "description": "HH:MM:SS"
          },
          "kind": {
            "enum": [
              "said_dont_understand",
              "long_silence",
              "wrong_answer",
              "asked_repeat"
            ],
            "type": "string"
          },
          "quote": {
            "type": "string",
            "maxLength": 300
          },
          "skill_id": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$",
            "nullable": true
          }
        },
        "propertyOrdering": [
          "t",
          "kind",
          "quote",
          "skill_id"
        ]
      }
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text_instructor",
          "text_student",
          "skill_id",
          "evidence"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
            "description": "Katalogdaki etiket; yoksa null ve metin serbest",
            "nullable": true
          },
          "skill_id": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
          },
          "text_instructor": {
            "type": "string",
            "maxLength": 200
          },
          "text_student": {
            "type": "string",
            "maxLength": 200
          },
          "resolved_in_lesson": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "speaker",
                "quote",
                "t"
              ],
              "properties": {
                "speaker": {
                  "enum": [
                    "ÖĞRENCİ",
                    "EĞİTMEN"
                  ],
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 300,
                  "description": "Alıntı; ad içermez"
                },
                "t": {
                  "type": "string",
                  "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
                  "description": "HH:MM:SS"
                },
                "t_end": {
                  "type": "string",
                  "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
                  "description": "HH:MM:SS"
                }
              },
              "propertyOrdering": [
                "speaker",
                "quote",
                "t",
                "t_end"
              ]
            }
          }
        },
        "propertyOrdering": [
          "tag",
          "skill_id",
          "text_instructor",
          "text_student",
          "resolved_in_lesson",
          "evidence"
        ]
      }
    },
    "commitments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "who",
          "kind",
          "text",
          "t"
        ],
        "properties": {
          "who": {
            "enum": [
              "ÖĞRENCİ",
              "EĞİTMEN"
            ],
            "type": "string"
          },
          "kind": {
            "enum": [
              "homework",
              "promise",
              "deadline"
            ],
            "type": "string"
          },
          "text": {
            "type": "string",
            "maxLength": 300
          },
          "due": {
            "type": "string",
            "nullable": true
          },
          "t": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
            "description": "HH:MM:SS"
          }
        },
        "propertyOrdering": [
          "who",
          "kind",
          "text",
          "due",
          "t"
        ]
      }
    },
    "talk": {
      "type": "object",
      "required": [
        "student_ratio",
        "student_questions",
        "attention",
        "morale"
      ],
      "properties": {
        "student_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "student_questions": {
          "type": "integer",
          "minimum": 0
        },
        "attention": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        "morale": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ],
          "type": "string"
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        }
      },
      "propertyOrdering": [
        "student_ratio",
        "student_questions",
        "attention",
        "morale",
        "notes"
      ]
    },
    "previous_profile_check": {
      "type": "array",
      "description": "seed_profile'daki açık yanılgılar için",
      "items": {
        "type": "object",
        "required": [
          "misconception_id",
          "status"
        ],
        "properties": {
          "misconception_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "still_present",
              "improved",
              "not_observed"
            ],
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "speaker",
                "quote",
                "t"
              ],
              "properties": {
                "speaker": {
                  "enum": [
                    "ÖĞRENCİ",
                    "EĞİTMEN"
                  ],
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 300,
                  "description": "Alıntı; ad içermez"
                },
                "t": {
                  "type": "string",
                  "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
                  "description": "HH:MM:SS"
                },
                "t_end": {
                  "type": "string",
                  "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
                  "description": "HH:MM:SS"
                }
              },
              "propertyOrdering": [
                "speaker",
                "quote",
                "t",
                "t_end"
              ]
            }
          }
        },
        "propertyOrdering": [
          "misconception_id",
          "status",
          "evidence"
        ]
      }
    },
    "next_step": {
      "type": "object",
      "required": [
        "for_student",
        "for_instructor"
      ],
      "properties": {
        "for_student": {
          "type": "string",
          "maxLength": 400
        },
        "for_instructor": {
          "type": "string",
          "maxLength": 400
        }
      },
      "propertyOrdering": [
        "for_student",
        "for_instructor"
      ]
    },
    "model_notes": {
      "type": "object",
      "required": [
        "model",
        "prompt_version",
        "cost_usd",
        "tokens_in",
        "tokens_out"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "tokens_in": {
          "type": "integer"
        },
        "tokens_out": {
          "type": "integer"
        },
        "frames": {
          "type": "integer"
        }
      },
      "propertyOrdering": [
        "model",
        "prompt_version",
        "cost_usd",
        "tokens_in",
        "tokens_out",
        "frames"
      ]
    }
  },
  "propertyOrdering": [
    "schema_version",
    "lesson_ref",
    "student_ref",
    "duration_min",
    "skills",
    "questions",
    "hesitations",
    "misconceptions",
    "commitments",
    "talk",
    "previous_profile_check",
    "next_step",
    "model_notes"
  ]
}
