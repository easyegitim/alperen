{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/question-item.json",
  "title": "QuestionItem",
  "description": "Soru maddesi. Cevap anahtarı BU NESNEDE YOKTUR (answer-key ayrı sözleşmedir).",
  "x-version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "curriculum_code",
    "kind",
    "skill_ids",
    "stem",
    "figure",
    "source",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "$ref": "common.json#/$defs/uuid"
    },
    "curriculum_code": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[A-Z]{2,5}@[0-9]{4}\\.[0-9]+$",
      "examples": [
        "TYT-MAT@2026.1"
      ]
    },
    "kind": {
      "enum": [
        "mcq",
        "numeric"
      ]
    },
    "skill_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "common.json#/$defs/skillId"
      }
    },
    "stem": {
      "type": "string",
      "minLength": 10,
      "maxLength": 900,
      "description": "Soru kökü; formüller düz metin/kod biçiminde; şekil varsa kök şekli kelimelerle de anlatır"
    },
    "stem_values": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string"
        ]
      },
      "description": "Şekil denetiminin karşılaştırdığı değerler (kenar, açı, eksen)"
    },
    "figure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "code",
            "alt_text"
          ],
          "properties": {
            "tool": {
              "enum": [
                "matplotlib",
                "svg",
                "tikz",
                "vega-lite",
                "schemdraw",
                "rdkit",
                "graphviz",
                "latex",
                "template"
              ]
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "alt_text": {
              "type": "string",
              "minLength": 15,
              "maxLength": 400,
              "description": "Şekli kelimelerle anlatır (Telegram altyazısı, alt)"
            },
            "expected_px": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min_w": {
                  "type": "integer"
                },
                "max_w": {
                  "type": "integer"
                },
                "min_h": {
                  "type": "integer"
                },
                "max_h": {
                  "type": "integer"
                }
              }
            },
            "render": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "enum": [
                    "pending",
                    "rendered",
                    "failed"
                  ]
                },
                "png_path": {
                  "type": "string"
                },
                "width_px": {
                  "type": "integer"
                },
                "height_px": {
                  "type": "integer"
                },
                "bytes": {
                  "type": "integer"
                },
                "vision": {
                  "enum": [
                    "pending",
                    "match",
                    "mismatch",
                    "not_applicable",
                    "skipped"
                  ]
                },
                "attempts": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              }
            }
          }
        }
      ]
    },
    "options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "description": "Tam dört şık, anahtarlar sırayla A, B, C, D (yinelenen, eksik ya da sırası bozuk anahtar düşer; Telegram A·B·C·D düğmeleri ve grade_attempt aynı sırayı varsayar). En az iki şık misconception_tag=null taşır (doğru şık + en az bir etiketsiz çeldirici).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "text",
          "misconception_tag"
        ],
        "properties": {
          "key": {
            "$ref": "common.json#/$defs/optionKey"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "misconception_tag": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.json#/$defs/tag"
              }
            ],
            "description": "Yanlış şıkkın kodladığı yanılgı. DOĞRU ŞIK BU DİZİDEN ÇIKARILAMAZ: doğru şık null taşır VE en az bir çeldirici de null taşır (en az iki null zorunlu); LLM ve öğrenci yolu şıkları app.strip_tags ile etiketsiz görür."
          }
        }
      },
      "contains": {
        "type": "object",
        "required": [
          "misconception_tag"
        ],
        "properties": {
          "misconception_tag": {
            "type": "null"
          }
        }
      },
      "minContains": 2,
      "allOf": [
        {
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "properties": {
                "key": {
                  "const": "A"
                }
              }
            },
            {
              "properties": {
                "key": {
                  "const": "B"
                }
              }
            },
            {
              "properties": {
                "key": {
                  "const": "C"
                }
              }
            },
            {
              "properties": {
                "key": {
                  "const": "D"
                }
              }
            }
          ]
        }
      ]
    },
    "difficulty": {
      "$ref": "common.json#/$defs/probability"
    },
    "source": {
      "enum": [
        "template",
        "llm",
        "instructor",
        "diagnostic"
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "template-params.json#/$defs/value"
          },
          "description": "Şablon parametreleri (template-params ile aynı değer kuralı: sayı, metin, mantıksal, null, bunların düz dizisi ya da bir düzey düz nesne)"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sympy",
        "render",
        "vision",
        "attempts",
        "status"
      ],
      "properties": {
        "schema": {
          "type": "boolean"
        },
        "sympy": {
          "enum": [
            "verified",
            "failed",
            "not_applicable",
            "pending"
          ]
        },
        "render": {
          "enum": [
            "ok",
            "failed",
            "size_mismatch",
            "not_applicable",
            "pending"
          ]
        },
        "vision": {
          "enum": [
            "match",
            "mismatch",
            "not_applicable",
            "pending",
            "skipped"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "status": {
          "enum": [
            "draft",
            "pending_review",
            "approved",
            "rejected",
            "retired"
          ]
        },
        "review_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "cost_usd": {
          "$ref": "common.json#/$defs/usd"
        },
        "prompt_version": {
          "type": "string"
        },
        "prompt_hash": {
          "type": "string"
        },
        "created_at": {
          "$ref": "common.json#/$defs/dateTime"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "mcq"
          }
        }
      },
      "then": {
        "required": [
          "options"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "numeric"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "options"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "sympy": {
                "enum": [
                  "verified",
                  "not_applicable"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
