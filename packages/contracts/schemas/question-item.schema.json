{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/question-item.json",
  "title": "QuestionItem",
  "description": "Soru maddesi. Cevap anahtarı BU NESNEDE YOKTUR (answer-key ayrı sözleşmedir).",
  "x-version": "2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "curriculum_code": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,8}(-[A-Z0-9]{2,8})*@[0-9]{4}\\.[0-9]+$",
      "description": "Örnek: TYT-MAT@2026.1"
    },
    "kind": {
      "type": "string",
      "enum": [
        "mcq",
        "numeric"
      ]
    },
    "skill_ids": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
      }
    },
    "stem": {
      "type": "string",
      "minLength": 10,
      "maxLength": 900,
      "description": "Soru kökü; formüller düz metin/kod; şekil varsa kök şekli kelimelerle de anlatır"
    },
    "stem_values": {
      "description": "Şekil denetiminin karşılaştırdığı değerler",
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string"
        ]
      }
    },
    "figure": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "enum": [
                "matplotlib",
                "svg",
                "tikz",
                "vega-lite",
                "schemdraw",
                "rdkit",
                "graphviz",
                "latex",
                "template"
              ]
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "alt_text": {
              "type": "string",
              "minLength": 15,
              "maxLength": 400,
              "description": "Şekli kelimelerle anlatır"
            },
            "expected_px": {
              "type": "object",
              "properties": {
                "min_w": {
                  "type": "integer"
                },
                "max_w": {
                  "type": "integer"
                },
                "min_h": {
                  "type": "integer"
                },
                "max_h": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            },
            "render": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "rendered",
                    "failed"
                  ]
                },
                "png_path": {
                  "type": "string"
                },
                "width_px": {
                  "type": "integer"
                },
                "height_px": {
                  "type": "integer"
                },
                "bytes": {
                  "type": "integer"
                },
                "vision": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "match",
                    "mismatch",
                    "not_applicable",
                    "skipped"
                  ]
                },
                "attempts": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "tool",
            "code",
            "alt_text"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "options": {
      "description": "Tam dört şık, anahtarlar sırayla A, B, C, D; en az iki şık misconception_tag=null taşır",
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "misconception_tag": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
                "description": "Yanlış şıkkın kodladığı yanılgı; doğru şık ve en az bir çeldirici null taşır"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "text",
          "misconception_tag"
        ],
        "additionalProperties": false
      },
      "contains": {
        "type": "object",
        "required": [
          "misconception_tag"
        ],
        "properties": {
          "misconception_tag": {
            "type": "null"
          }
        }
      },
      "minContains": 2,
      "allOf": [
        {
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "properties": {
                "key": {
                  "const": "A"
                }
              }
            },
            {
              "properties": {
                "key": {
                  "const": "B"
                }
              }
            },
            {
              "properties": {
                "key": {
                  "const": "C"
                }
              }
            },
            {
              "properties": {
                "key": {
                  "const": "D"
                }
              }
            }
          ]
        }
      ]
    },
    "difficulty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "template",
        "llm",
        "instructor",
        "diagnostic"
      ]
    },
    "template": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": [
                  "number",
                  "string",
                  "boolean",
                  "null"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "string",
                    "boolean",
                    "null"
                  ]
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "string",
                    "boolean",
                    "null"
                  ]
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "boolean"
        },
        "sympy": {
          "type": "string",
          "enum": [
            "verified",
            "failed",
            "not_applicable",
            "pending"
          ]
        },
        "render": {
          "type": "string",
          "enum": [
            "ok",
            "failed",
            "size_mismatch",
            "not_applicable",
            "pending"
          ]
        },
        "vision": {
          "type": "string",
          "enum": [
            "match",
            "mismatch",
            "not_applicable",
            "pending",
            "skipped"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "pending_review",
            "approved",
            "rejected",
            "retired"
          ]
        },
        "review_note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema",
        "sympy",
        "render",
        "vision",
        "attempts",
        "status"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "prompt_version": {
          "type": "string"
        },
        "prompt_hash": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "curriculum_code",
    "kind",
    "skill_ids",
    "stem",
    "figure",
    "source",
    "verification"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "mcq"
          }
        }
      },
      "then": {
        "required": [
          "options"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "numeric"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "options"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "sympy": {
                "enum": [
                  "verified",
                  "not_applicable"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
