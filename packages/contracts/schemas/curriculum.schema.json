{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/curriculum.json",
  "title": "CurriculumBundle",
  "description": "Müfredat sürümü: curriculum.json + skills.json + prerequisites.json tek nesnede.",
  "x-version": "2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "curriculum": {
      "$ref": "#/$defs/curriculum"
    },
    "skills": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prerequisite"
      }
    }
  },
  "required": [
    "curriculum",
    "skills",
    "prerequisites"
  ],
  "additionalProperties": false,
  "$defs": {
    "curriculum": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,8}(-[A-Z0-9]{2,8})*$",
          "description": "Örnek: TYT-MAT"
        },
        "authority": {
          "type": "string",
          "enum": [
            "MEB",
            "ÖSYM",
            "UNI",
            "OTHER"
          ]
        },
        "year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]+$",
          "description": "Örnek: 2026.1"
        },
        "label": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "retired"
          ]
        },
        "period_label": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "diagnostic_exempt": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          }
        }
      },
      "required": [
        "code",
        "authority",
        "year",
        "version",
        "label",
        "status"
      ],
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 600
            },
            {
              "type": "null"
            }
          ]
        },
        "is_leaf": {
          "type": "boolean"
        },
        "order_no": {
          "type": "integer",
          "minimum": 0
        },
        "p_init": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.999
        },
        "p_learn": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.999
        },
        "p_guess": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.999
        },
        "p_slip": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.999
        }
      },
      "required": [
        "id",
        "parent_id",
        "name",
        "is_leaf"
      ],
      "additionalProperties": false
    },
    "prerequisite": {
      "type": "object",
      "properties": {
        "skill_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
        },
        "prereq_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "curriculum",
            "instructor",
            "inferred"
          ]
        }
      },
      "required": [
        "skill_id",
        "prereq_id",
        "strength"
      ],
      "additionalProperties": false
    }
  }
}
