{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/curriculum.json",
  "title": "CurriculumBundle",
  "description": "Müfredat sürümünün birleşik doğrulaması: curriculum.json + skills.json + prerequisites.json tek nesnede ({curriculum, skills, prerequisites}). Tekil dosyalar $defs ile doğrulanabilir (curriculum#/$defs/skill vb.).",
  "x-version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "curriculum",
    "skills",
    "prerequisites"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "curriculum": {
      "$ref": "#/$defs/curriculum"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prerequisite"
      }
    }
  },
  "$defs": {
    "curriculum": {
      "type": "object",
      "additionalProperties": false,
      "description": "curriculum.json (curricula satırı + dönem + teşhis istisnaları)",
      "required": [
        "code",
        "authority",
        "year",
        "version",
        "label",
        "status"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{2,5}-[A-Z]{2,5}$",
          "examples": [
            "TYT-MAT"
          ]
        },
        "authority": {
          "enum": [
            "MEB",
            "ÖSYM",
            "UNI",
            "OTHER"
          ]
        },
        "year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]+$",
          "examples": [
            "2026.1"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "retired"
          ],
          "description": "Zorunlu; export-sql.py curricula.status olarak aynen yazar"
        },
        "period_label": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "description": "settings.default_period ile aynı (ör. 'YKS 2027')"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "diagnostic_exempt": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/skillId"
          },
          "description": "Teşhis maddesi olmayan, pratikte ölçülen yapraklar"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "description": "skills.json öğesi (skills satırı)",
      "required": [
        "id",
        "parent_id",
        "name",
        "is_leaf"
      ],
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/skillId"
        },
        "parent_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.json#/$defs/skillId"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 600
        },
        "is_leaf": {
          "type": "boolean",
          "description": "Düğüm kazanımlar (false) mastery tutmaz"
        },
        "order_no": {
          "type": "integer",
          "minimum": 0
        },
        "p_init": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.999
        },
        "p_learn": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.999
        },
        "p_guess": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.999
        },
        "p_slip": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.999
        }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "description": "prerequisites.json öğesi (skill_prerequisites satırı)",
      "required": [
        "skill_id",
        "prereq_id",
        "strength"
      ],
      "properties": {
        "skill_id": {
          "$ref": "common.json#/$defs/skillId"
        },
        "prereq_id": {
          "$ref": "common.json#/$defs/skillId"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "enum": [
            "curriculum",
            "instructor",
            "inferred"
          ]
        }
      }
    }
  }
}
