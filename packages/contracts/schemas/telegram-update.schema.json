{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/telegram-update.json",
  "title": "TelegramUpdate",
  "description": "Sahte Telegram (fixtures/telegram, Worker testleri) için daraltılmış Bot API Update nesnesi: message, edited_message, callback_query, my_chat_member, chat_member (setWebhook allowed_updates ile aynı küme). Tam olarak bir olay alanı taşır. YALNIZ sahte/fikstür güncellemelerini doğrular: gerçek Bot API güncellemeleri burada tanımsız alanlar taşır (link_preview_options, sticker, quote, external_reply, chat.photo …); Worker canlı webhook güncellemesini bu şemayla REDDETMEZ, yalnız kullandığı alanları okur.",
  "x-version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "update_id"
  ],
  "properties": {
    "update_id": {
      "type": "integer",
      "minimum": 0
    },
    "message": {
      "$ref": "#/$defs/message"
    },
    "edited_message": {
      "$ref": "#/$defs/message"
    },
    "callback_query": {
      "$ref": "#/$defs/callbackQuery"
    },
    "my_chat_member": {
      "$ref": "#/$defs/chatMemberUpdated"
    },
    "chat_member": {
      "$ref": "#/$defs/chatMemberUpdated"
    }
  },
  "oneOf": [
    {
      "required": [
        "message"
      ]
    },
    {
      "required": [
        "edited_message"
      ]
    },
    {
      "required": [
        "callback_query"
      ]
    },
    {
      "required": [
        "my_chat_member"
      ]
    },
    {
      "required": [
        "chat_member"
      ]
    }
  ],
  "$defs": {
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "is_bot",
        "first_name"
      ],
      "description": "Telegram User (alt küme). first_name/last_name yalnız resolve_telegram'a gider.",
      "properties": {
        "id": {
          "type": "integer"
        },
        "is_bot": {
          "type": "boolean"
        },
        "first_name": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "language_code": {
          "type": "string"
        },
        "is_premium": {
          "type": "boolean"
        },
        "added_to_attachment_menu": {
          "type": "boolean"
        },
        "can_join_groups": {
          "type": "boolean"
        },
        "can_read_all_group_messages": {
          "type": "boolean"
        },
        "supports_inline_queries": {
          "type": "boolean"
        },
        "can_connect_to_business": {
          "type": "boolean"
        },
        "has_main_web_app": {
          "type": "boolean"
        }
      }
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "type": {
          "enum": [
            "private",
            "group",
            "supergroup",
            "channel"
          ]
        },
        "title": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "first_name": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "is_forum": {
          "type": "boolean"
        },
        "all_members_are_administrators": {
          "type": "boolean"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "offset",
        "length"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        },
        "user": {
          "$ref": "#/$defs/user"
        },
        "language": {
          "type": "string"
        },
        "custom_emoji_id": {
          "type": "string"
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "file_unique_id",
        "duration"
      ],
      "properties": {
        "file_id": {
          "type": "string"
        },
        "file_unique_id": {
          "type": "string"
        },
        "file_size": {
          "type": "integer",
          "minimum": 0
        },
        "duration": {
          "type": "integer",
          "minimum": 0
        },
        "mime_type": {
          "type": "string"
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "file_unique_id",
        "duration"
      ],
      "properties": {
        "file_id": {
          "type": "string"
        },
        "file_unique_id": {
          "type": "string"
        },
        "file_size": {
          "type": "integer",
          "minimum": 0
        },
        "duration": {
          "type": "integer",
          "minimum": 0
        },
        "mime_type": {
          "type": "string"
        },
        "performer": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "file_name": {
          "type": "string"
        }
      }
    },
    "photoSize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "file_unique_id",
        "width",
        "height"
      ],
      "properties": {
        "file_id": {
          "type": "string"
        },
        "file_unique_id": {
          "type": "string"
        },
        "file_size": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "file_unique_id"
      ],
      "properties": {
        "file_id": {
          "type": "string"
        },
        "file_unique_id": {
          "type": "string"
        },
        "file_size": {
          "type": "integer",
          "minimum": 0
        },
        "file_name": {
          "type": "string"
        },
        "mime_type": {
          "type": "string"
        }
      }
    },
    "inlineButton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "callback_data": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "inlineKeyboardMarkup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inline_keyboard"
      ],
      "properties": {
        "inline_keyboard": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/inlineButton"
            }
          }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "date",
        "chat"
      ],
      "properties": {
        "message_id": {
          "type": "integer"
        },
        "message_thread_id": {
          "type": "integer"
        },
        "from": {
          "$ref": "#/$defs/user"
        },
        "sender_chat": {
          "$ref": "#/$defs/chat"
        },
        "date": {
          "type": "integer",
          "description": "Unix zamanı (saniye)"
        },
        "edit_date": {
          "type": "integer"
        },
        "chat": {
          "$ref": "#/$defs/chat"
        },
        "is_topic_message": {
          "type": "boolean"
        },
        "is_automatic_forward": {
          "type": "boolean"
        },
        "has_protected_content": {
          "type": "boolean"
        },
        "forward_origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "date"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "date": {
              "type": "integer"
            }
          }
        },
        "via_bot": {
          "$ref": "#/$defs/user"
        },
        "media_group_id": {
          "type": "string"
        },
        "author_signature": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "caption": {
          "type": "string"
        },
        "caption_entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "voice": {
          "$ref": "#/$defs/voice"
        },
        "audio": {
          "$ref": "#/$defs/audio"
        },
        "photo": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/photoSize"
          }
        },
        "document": {
          "$ref": "#/$defs/document"
        },
        "new_chat_members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/user"
          }
        },
        "left_chat_member": {
          "$ref": "#/$defs/user"
        },
        "new_chat_title": {
          "type": "string"
        },
        "group_chat_created": {
          "type": "boolean"
        },
        "supergroup_chat_created": {
          "type": "boolean"
        },
        "migrate_to_chat_id": {
          "type": "integer"
        },
        "migrate_from_chat_id": {
          "type": "integer"
        },
        "pinned_message": {
          "$ref": "#/$defs/replyMessage"
        },
        "reply_markup": {
          "$ref": "#/$defs/inlineKeyboardMarkup"
        },
        "reply_to_message": {
          "$ref": "#/$defs/replyMessage",
          "description": "Telegram yanıtlanan mesajda reply_to_message'ı tekrar etmez"
        }
      }
    },
    "replyMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "date",
        "chat"
      ],
      "properties": {
        "message_id": {
          "type": "integer"
        },
        "message_thread_id": {
          "type": "integer"
        },
        "from": {
          "$ref": "#/$defs/user"
        },
        "sender_chat": {
          "$ref": "#/$defs/chat"
        },
        "date": {
          "type": "integer",
          "description": "Unix zamanı (saniye)"
        },
        "edit_date": {
          "type": "integer"
        },
        "chat": {
          "$ref": "#/$defs/chat"
        },
        "is_topic_message": {
          "type": "boolean"
        },
        "is_automatic_forward": {
          "type": "boolean"
        },
        "has_protected_content": {
          "type": "boolean"
        },
        "forward_origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "date"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "date": {
              "type": "integer"
            }
          }
        },
        "via_bot": {
          "$ref": "#/$defs/user"
        },
        "media_group_id": {
          "type": "string"
        },
        "author_signature": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "caption": {
          "type": "string"
        },
        "caption_entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "voice": {
          "$ref": "#/$defs/voice"
        },
        "audio": {
          "$ref": "#/$defs/audio"
        },
        "photo": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/photoSize"
          }
        },
        "document": {
          "$ref": "#/$defs/document"
        },
        "new_chat_members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/user"
          }
        },
        "left_chat_member": {
          "$ref": "#/$defs/user"
        },
        "new_chat_title": {
          "type": "string"
        },
        "group_chat_created": {
          "type": "boolean"
        },
        "supergroup_chat_created": {
          "type": "boolean"
        },
        "migrate_to_chat_id": {
          "type": "integer"
        },
        "migrate_from_chat_id": {
          "type": "integer"
        },
        "reply_markup": {
          "$ref": "#/$defs/inlineKeyboardMarkup"
        }
      },
      "description": "Yanıtlanan/sabitlenen mesaj (iç içe reply_to_message yok; şema özyinelemesizdir)"
    },
    "callbackQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "chat_instance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/user"
        },
        "message": {
          "$ref": "#/$defs/replyMessage"
        },
        "inline_message_id": {
          "type": "string"
        },
        "chat_instance": {
          "type": "string"
        },
        "data": {
          "type": "string",
          "maxLength": 64,
          "description": "ans:<session>:<question>:<key> | hint:<question> | human:<message_id> | consent:<kind>:<yes|no> | diag:continue|later"
        }
      }
    },
    "chatMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "user"
      ],
      "description": "ChatMember (owner/administrator/member/restricted/left/kicked birleşik alt kümesi)",
      "properties": {
        "status": {
          "enum": [
            "creator",
            "administrator",
            "member",
            "restricted",
            "left",
            "kicked"
          ]
        },
        "user": {
          "$ref": "#/$defs/user"
        },
        "is_anonymous": {
          "type": "boolean"
        },
        "custom_title": {
          "type": "string"
        },
        "until_date": {
          "type": "integer"
        },
        "is_member": {
          "type": "boolean"
        },
        "can_be_edited": {
          "type": "boolean"
        },
        "can_manage_chat": {
          "type": "boolean"
        },
        "can_delete_messages": {
          "type": "boolean"
        },
        "can_manage_video_chats": {
          "type": "boolean"
        },
        "can_restrict_members": {
          "type": "boolean"
        },
        "can_promote_members": {
          "type": "boolean"
        },
        "can_change_info": {
          "type": "boolean"
        },
        "can_invite_users": {
          "type": "boolean"
        },
        "can_post_messages": {
          "type": "boolean"
        },
        "can_edit_messages": {
          "type": "boolean"
        },
        "can_pin_messages": {
          "type": "boolean"
        },
        "can_manage_topics": {
          "type": "boolean"
        },
        "can_post_stories": {
          "type": "boolean"
        },
        "can_edit_stories": {
          "type": "boolean"
        },
        "can_delete_stories": {
          "type": "boolean"
        },
        "can_send_messages": {
          "type": "boolean"
        },
        "can_send_audios": {
          "type": "boolean"
        },
        "can_send_documents": {
          "type": "boolean"
        },
        "can_send_photos": {
          "type": "boolean"
        },
        "can_send_videos": {
          "type": "boolean"
        },
        "can_send_video_notes": {
          "type": "boolean"
        },
        "can_send_voice_notes": {
          "type": "boolean"
        },
        "can_send_polls": {
          "type": "boolean"
        },
        "can_send_other_messages": {
          "type": "boolean"
        },
        "can_add_web_page_previews": {
          "type": "boolean"
        }
      }
    },
    "chatMemberUpdated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chat",
        "from",
        "date",
        "old_chat_member",
        "new_chat_member"
      ],
      "properties": {
        "chat": {
          "$ref": "#/$defs/chat"
        },
        "from": {
          "$ref": "#/$defs/user"
        },
        "date": {
          "type": "integer"
        },
        "old_chat_member": {
          "$ref": "#/$defs/chatMember"
        },
        "new_chat_member": {
          "$ref": "#/$defs/chatMember"
        },
        "via_join_request": {
          "type": "boolean"
        },
        "via_chat_folder_invite_link": {
          "type": "boolean"
        }
      }
    }
  }
}
