{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/exam-priority-plan.json",
  "title": "ExamPriorityPlan",
  "description": "Kalem (b) çıktısı: geçmiş sınavların sıklık analizine göre öncelikler. Tahmin değildir; soru metni taşımaz.",
  "x-version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "course_code",
    "period",
    "title",
    "years_total",
    "rows",
    "others",
    "evidence_count",
    "generated_at"
  ],
  "x-forbidden-words": [
    "tahmin",
    "çıkacak",
    "kesin",
    "garanti"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "course_code": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "title": {
      "const": "Sıklık analizine göre öncelikler"
    },
    "years_total": {
      "type": "integer",
      "minimum": 2
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "topic",
          "kind",
          "hits",
          "years",
          "points_text",
          "evidence_count",
          "evidence_item_ids",
          "syllabus_alignment"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "topic": {
            "type": "string",
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "ispat",
              "hesap",
              "çoktan seçmeli",
              "diğer"
            ]
          },
          "skill_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.json#/$defs/skillId"
              }
            ]
          },
          "hits": {
            "type": "integer",
            "minimum": 1
          },
          "years": {
            "type": "integer",
            "minimum": 1
          },
          "points_text": {
            "type": "string",
            "pattern": "^≈[0-9]+ puan$"
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 1
          },
          "evidence_item_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.json#/$defs/uuid"
            },
            "description": "Eğitmen arşivine bağlantı; soru metni yok"
          },
          "syllabus_alignment": {
            "enum": [
              "covered_and_asked",
              "covered_never_asked",
              "asked_not_in_syllabus"
            ]
          },
          "variant_question_ids": {
            "type": "array",
            "items": {
              "$ref": "common.json#/$defs/uuid"
            },
            "description": "ÖZGÜN varyantlar (questions.source='llm', approved)"
          }
        }
      }
    },
    "others": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "uncovered_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "İzlencede var, hiç sorulmamış"
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "$ref": "common.json#/$defs/dateTime"
    }
  }
}
