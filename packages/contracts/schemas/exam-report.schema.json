{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/exam-report.json",
  "title": "ExamReport",
  "description": "Deneme analiz raporu (belge AST, kind=report): tek cümlelik özet, bölüm netleri, kazanım ısı haritası, hata nedenleri, en çok üç sonraki adım. Bölümler 1 genel görünüm, 2 kazanımlar, 3 sonraki adım; grafik data_ref adları section_nets, skill_map, error_causes, time_per_question, trend.",
  "x-version": "2.0",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "report"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "meta": {
      "type": "object",
      "properties": {
        "course_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "generated_on": {
          "type": "string",
          "format": "date"
        },
        "language": {
          "type": "string",
          "const": "tr"
        },
        "personalized": {
          "type": "boolean",
          "description": "Belge öğrencinin dossier verisiyle kişiselleştirildi mi"
        },
        "duration_min": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "course_title",
        "subtitle",
        "generated_on",
        "language",
        "personalized",
        "duration_min"
      ],
      "additionalProperties": false
    },
    "sections": {
      "maxItems": 60,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "no": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "no",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "blocks": {
      "minItems": 1,
      "maxItems": 600,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "heading"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Belge içinde tekil blok kimliği"
              },
              "section_no": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "id",
              "section_no",
              "level",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "paragraph"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Belge içinde tekil blok kimliği"
              },
              "section_no": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000,
                "description": "Satır içi matematik $...$ ile"
              }
            },
            "required": [
              "type",
              "id",
              "section_no",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "math_display"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Belge içinde tekil blok kimliği"
              },
              "section_no": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              },
              "latex": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "type",
              "id",
              "section_no",
              "latex"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "definition_box"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Belge içinde tekil blok kimliği"
              },
              "section_no": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              },
              "term": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1500
              }
            },
            "required": [
              "type",
              "id",
              "section_no",
              "term",
              "body"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "summary_box"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Belge içinde tekil blok kimliği"
              },
              "section_no": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "bullets": {
                "minItems": 1,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              }
            },
            "required": [
              "type",
              "id",
              "section_no",
              "title",
              "bullets"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "worked_example"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Belge içinde tekil blok kimliği"
              },
              "section_no": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "problem": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1500
              },
              "steps": {
                "minItems": 1,
                "maxItems": 15,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                }
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "type",
              "id",
              "section_no",
              "title",
              "problem",
              "steps",
              "answer"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "common_mistake_callout"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Belge içinde tekil blok kimliği"
              },
              "section_no": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              },
              "pattern_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Gerçek bir örüntüye başvuru: yanılgı etiketi ya da patterns.md girdisi"
              },
              "pattern_ref": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "enum": [
                          "patterns.md",
                          "misconception",
                          "analysis"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "description": "pattern_id ile aynı: patterns.md örüntü kimliği, yanılgı etiketi ya da analiz kimliği"
                      },
                      "date": {
                        "type": "string",
                        "format": "date",
                        "description": "Örüntünün gözlendiği (son) gün"
                      }
                    },
                    "required": [
                      "source",
                      "id",
                      "date"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Kişisel kutunun kaynağı; kişiselleştirilmiş notta zorunlu, genel uyarıda null"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              }
            },
            "required": [
              "type",
              "id",
              "section_no",
              "pattern_id",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "check_yourself"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Belge içinde tekil blok kimliği"
              },
              "section_no": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              },
              "answer_hidden": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              }
            },
            "required": [
              "type",
              "id",
              "section_no",
              "question",
              "answer_hidden"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "figure"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Belge içinde tekil blok kimliği"
              },
              "section_no": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              },
              "source": {
                "type": "string",
                "enum": [
                  "svg"
                ]
              },
              "svg": {
                "type": "string",
                "maxLength": 60000,
                "description": "source=svg ise satır içi SVG; figure_code verilen figürde boş kalır (worker üretir)"
              },
              "alt": {
                "type": "string",
                "minLength": 5,
                "maxLength": 400,
                "description": "Şekli kelimelerle anlatır"
              }
            },
            "required": [
              "type",
              "id",
              "section_no",
              "source",
              "alt"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "table"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Belge içinde tekil blok kimliği"
              },
              "section_no": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              },
              "caption": {
                "type": "string",
                "maxLength": 200
              },
              "header": {
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 120
                }
              },
              "rows": {
                "minItems": 1,
                "maxItems": 60,
                "type": "array",
                "items": {
                  "maxItems": 12,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            },
            "required": [
              "type",
              "id",
              "section_no",
              "header",
              "rows"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "page_break"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Belge içinde tekil blok kimliği"
              },
              "section_no": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              }
            },
            "required": [
              "type",
              "id",
              "section_no"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "chart"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Belge içinde tekil blok kimliği"
              },
              "section_no": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              },
              "chart_kind": {
                "type": "string",
                "enum": [
                  "score_by_section",
                  "skill_heatmap",
                  "mastery_trend",
                  "time_per_question",
                  "error_cause_histogram",
                  "style_coverage"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "data_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Render anında deterministik doldurulan veri kaynağı adı"
              },
              "caption": {
                "type": "string",
                "maxLength": 300
              }
            },
            "required": [
              "type",
              "id",
              "section_no",
              "chart_kind",
              "title",
              "data_ref"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "keys": {
      "type": "array",
      "items": {
        "not": {}
      },
      "description": "Raporda boş: rapor cevap anahtarı taşımaz"
    }
  },
  "required": [
    "kind",
    "title",
    "meta",
    "sections",
    "blocks",
    "keys"
  ],
  "additionalProperties": false
}
