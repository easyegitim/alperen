{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/style-definition.json",
  "title": "StyleDefinition",
  "description": "Soru tarzı tanımları: küme kimliği, kod, ad, tanım (telifli örnek metni içermez), format, tuzak, zorluk bandı, kazanımlar.",
  "x-version": "2.0",
  "type": "object",
  "properties": {
    "styles": {
      "minItems": 1,
      "maxItems": 60,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cluster_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Girdideki küme kimliği"
          },
          "code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500,
            "description": "Tarzın tanımı; soru metninden alıntı yapmaz"
          },
          "format": {
            "type": "string",
            "enum": [
              "text",
              "table",
              "graph",
              "geometry_figure",
              "word_problem",
              "other"
            ]
          },
          "trick": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "description": "Soruyu tuzaklı yapan unsur; yoksa null"
          },
          "difficulty_band": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "skill_ids": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
            }
          }
        },
        "required": [
          "cluster_id",
          "code",
          "name",
          "description",
          "format",
          "trick",
          "difficulty_band",
          "skill_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "styles"
  ],
  "additionalProperties": false
}
