{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/answer-key.json",
  "title": "AnswerKey",
  "description": "Cevap anahtarı: yalnız pipeline/seed ↔ register_answer_key. Worker bu şemayı içe almaz; secure.answer_keys satırının sözleşmesi.",
  "x-version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "solution",
    "sympy_status"
  ],
  "properties": {
    "question_id": {
      "$ref": "common.json#/$defs/uuid"
    },
    "correct_option": {
      "$ref": "common.json#/$defs/optionKey"
    },
    "numeric_value": {
      "type": "string",
      "description": "SymPy string: '7/8', '2*sqrt(3)'"
    },
    "numeric_tolerance": {
      "type": "number",
      "minimum": 0
    },
    "canonical_expr": {
      "type": "string",
      "description": "sympy.sympify edilebilir ifade; stem_values ile çözülür"
    },
    "solution": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "description": "Adım adım çözüm; doğrudan modda reveal_solution bunu döner"
    },
    "sympy_status": {
      "enum": [
        "verified",
        "failed",
        "not_applicable"
      ]
    },
    "sympy_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expr": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "matched_option": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "correct_option"
      ]
    },
    {
      "required": [
        "numeric_value"
      ]
    }
  ]
}
