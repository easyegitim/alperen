{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/exam-item.json",
  "title": "ExamItem",
  "description": "Sınav arşivinden çıkarılmış tek soru (exam_items). ocr_text hiçbir öğrenci çıktısına kopyalanmaz.",
  "x-version": "2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "source_id": {
      "type": "string",
      "format": "uuid"
    },
    "item_no": {
      "type": "integer",
      "minimum": 1
    },
    "topic": {
      "type": "string",
      "maxLength": 120
    },
    "kind": {
      "type": "string",
      "enum": [
        "proof",
        "calc",
        "mc",
        "other"
      ]
    },
    "points": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "year": {
      "type": "integer"
    },
    "term": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "vize",
            "final",
            "but",
            "deneme",
            "osym",
            "diger"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "instructor_alias": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^hoca-[A-Z]$"
        },
        {
          "type": "null"
        }
      ]
    },
    "skill_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ocr_text": {
      "type": "string",
      "description": "Yalnız eğitmen arşivi ve kümeleme; hiçbir öğrenci çıktısına kopyalanmaz"
    },
    "ocr_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "format": {
      "default": "other",
      "type": "string",
      "enum": [
        "text",
        "table",
        "graph",
        "geometry_figure",
        "word_problem",
        "other"
      ]
    },
    "trick": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "difficulty": {
      "default": null,
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0..1 zorluk"
        },
        {
          "type": "null"
        }
      ]
    },
    "skill_ids": {
      "default": [],
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
      }
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "item_no",
    "topic",
    "kind",
    "year",
    "ocr_text"
  ],
  "additionalProperties": false
}
