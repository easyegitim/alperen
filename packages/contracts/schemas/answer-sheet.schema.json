{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/answer-sheet.json",
  "title": "AnswerSheet",
  "description": "Optik formdan okunan işaretler. status=multiple (çift işaret) ve unclear için marked_option null olur; not düşülür.",
  "x-version": "2.0",
  "type": "object",
  "properties": {
    "booklet_type": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "unknown"
      ],
      "description": "Formdaki kitapçık türü"
    },
    "answers": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_no": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "status": {
            "type": "string",
            "enum": [
              "marked",
              "blank",
              "multiple",
              "unclear"
            ]
          },
          "marked_option": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Yalnız status=marked iken dolu"
          },
          "marks_seen": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E"
              ]
            },
            "description": "Satırda görülen tüm işaretler"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "question_no",
          "status",
          "marked_option",
          "marks_seen",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "booklet_type",
    "answers"
  ],
  "additionalProperties": false
}
