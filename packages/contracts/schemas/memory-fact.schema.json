{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/memory-fact.json",
  "title": "MemoryFact",
  "description": "Gece olgu çıkarımının tek olgusu (memory_facts satırı). Kaynak mesaj numarası zorunlu; ad içermez.",
  "x-version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "student_ref",
    "kind",
    "text",
    "source_message_ids",
    "confidence",
    "requires_approval"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "student_ref": {
      "$ref": "common.json#/$defs/studentRef"
    },
    "kind": {
      "enum": [
        "promise",
        "deadline",
        "unanswered_question",
        "morale",
        "topic_asked",
        "preference",
        "instructor_fact",
        "other"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 8,
      "maxLength": 300,
      "description": "İsim yok; 'öğrenci' veya 'eğitmen' der; üçüncü tekil"
    },
    "source_message_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "integer"
      },
      "description": "messages.id — kaynak zorunlu; günün mesajları arasında olmalı (pipeline doğrular)"
    },
    "confidence": {
      "$ref": "common.json#/$defs/probability"
    },
    "valid_until": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.json#/$defs/date"
        }
      ]
    },
    "morale_signal": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": -2,
      "maximum": 2
    },
    "requires_approval": {
      "type": "boolean",
      "description": "not/devamsızlık/puan/ödeme içeriyorsa true; bot approved olmadan kullanmaz"
    },
    "skill_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.json#/$defs/skillId"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "instructor_fact"
          }
        }
      },
      "then": {
        "properties": {
          "requires_approval": {
            "const": true
          }
        }
      }
    }
  ]
}
