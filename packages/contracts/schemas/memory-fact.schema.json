{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogrenmen.easy/schemas/memory-fact.json",
  "title": "MemoryFact",
  "description": "Tek olgu: tür, metin (isimsiz), kaynak mesaj numaraları, güven, onay gerekliliği.",
  "x-version": "2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "student_ref": {
      "type": "string",
      "pattern": "^s_[a-z2-7]{12}$",
      "description": "students.public_ref; ad ve uuid asla"
    },
    "kind": {
      "type": "string",
      "enum": [
        "promise",
        "deadline",
        "unanswered_question",
        "morale",
        "topic_asked",
        "preference",
        "instructor_fact",
        "other"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 8,
      "maxLength": 300,
      "description": "İsim yok; 'öğrenci' veya 'eğitmen' der; üçüncü tekil"
    },
    "source_message_ids": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "morale_signal": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "requires_approval": {
      "type": "boolean",
      "description": "not/devamsızlık/puan/ödeme içeriyorsa true"
    },
    "skill_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "student_ref",
    "kind",
    "text",
    "source_message_ids",
    "confidence",
    "requires_approval"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "instructor_fact"
          }
        }
      },
      "then": {
        "properties": {
          "requires_approval": {
            "const": true
          }
        }
      }
    }
  ]
}
