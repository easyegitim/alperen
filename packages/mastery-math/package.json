{
  "name": "@ogrenmen/mastery-math",
  "version": "0.1.0",
  "description": "Öğrenmen ustalık matematiği (BKT): TS + Python + SQL tek kaynak",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./bkt": {
      "types": "./src/bkt.ts",
      "default": "./src/bkt.ts"
    },
    "./fixtures/bkt-vectors.json": "./fixtures/bkt-vectors.json",
    "./sql/bkt.sql": "./sql/bkt.sql",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "sql",
    "fixtures"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "bun-types": "1.1.42",
    "typescript": "5.6.3"
  }
}
