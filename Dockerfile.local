# Öğrenmen yerel deneme kapsayıcısı: uygulama + worker + ders servisi + PDF üretimi tek imajda (Linux).
# Windows/Mac/Linux'ta aynı şekilde çalışır; yalnız Docker gerekir.  Kullanım: docker-compose.local.yml
# Taban Python 3.13 (numpy 2.5 / matplotlib 3.11 Python >=3.12 ister); Node 22 üstüne eklenir.
FROM python:3.13-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    NEXT_TELEMETRY_DISABLED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg postgresql-client ca-certificates curl unzip gnupg git \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version && python3 --version

RUN pip install --no-cache-dir sympy==1.14.0 matplotlib==3.11.2 numpy==2.5.3 httpx==0.28.1 jsonschema==4.26.0 \
    && python3 -I -c "import sympy, matplotlib, numpy, httpx, jsonschema; print('python paketleri tamam')" \
    && npm install -g bun@1.4.2 \
    && bun --version

WORKDIR /app
# Önce bağımlılıklar (önbellek katmanı): yalnız package.json'lar ve kilit dosyası
COPY package.json bun.lock tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages packages
RUN bun install --frozen-lockfile || bun install

# Chromium (PDF) — Playwright 1.56.1
RUN bunx playwright@1.56.1 install --with-deps chromium

COPY . .
RUN bun install --frozen-lockfile || bun install

ENV OGRENMEN_IN_DOCKER=1 \
    OGRENMEN_BIND_HOST=0.0.0.0 \
    OGRENMEN_ENV_FILE=/data/.env.local
VOLUME ["/data"]
EXPOSE 3000 54321
CMD ["bun", "scripts/dev-local/up.ts"]
