# Öğrenmen yerel deneme ayarları.
# Kullanım:  cp .env.local.example .env.local   sonra .env.local dosyasını doldur.
# DİKKAT: .env.local dosyasını (ya da içindeki anahtarları) sohbete, e-postaya ya da GitHub'a KOYMA.
# Bu örnek dosyada gerçek anahtar yoktur; .env.local git'e girmez.

# ZORUNLU — Claude anahtarı. console.anthropic.com → API Keys → Create Key. "sk-ant-" ile başlar.
# Tırnak ve boşluk olmadan yapıştır. Console'da Billing bölümünden aylık harcama limiti koyman önerilir.
ANTHROPIC_API_KEY=

# İsteğe bağlı — ders kaydı yazıya dökme (Groq). Boşsa örnek (sahte) yazıya dökme kullanılır.
GROQ_API_KEY=

# İsteğe bağlı — anlamsal arama (Voyage). Boşsa anlamsal arama kapalı kalır.
VOYAGE_API_KEY=

# Veritabanı adresi. Docker ile (make local-db) açtıysan bunu değiştirme.
# Kendi Postgres 16 + pgvector kurulumunu kullanıyorsan buraya yaz.
OGRENMEN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# İsteğe bağlı — Python yolu. Boşsa "python3" kullanılır. Paketleri (sympy, matplotlib, numpy) başka bir Python'a
# kurduysan (ör. sanal ortam) onun tam yolunu yaz:  OGRENMEN_PYTHON=/Users/sen/venv/bin/python3
# OGRENMEN_PYTHON=
