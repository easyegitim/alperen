# Mobil (Expo) ortam değişkenleri. EXPO_PUBLIC_* değerler pakete gömülür; gizli anahtar KOYMA.
EXPO_PUBLIC_API_URL=http://localhost:3000            # Next.js API + web (yasal sayfalar)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=                       # publishable key
EXPO_PUBLIC_TURNSTILE_SITE_KEY=                      # boşsa captcha adımı atlanır (Supabase'de captcha kapalı olmalı)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=                      # RevenueCat public SDK anahtarı (gizli değil)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EAS_PROJECT_ID=
# Özellik bayrakları (UX kapısı; sunucu FEATURE_* değişkenleri son sözü söyler). Varsayılan kapalı.
EXPO_PUBLIC_FEATURE_EXPERT_NETWORK=false
EXPO_PUBLIC_FEATURE_WEEK_PASS=false
EXPO_PUBLIC_FEATURE_UNDER_18=false
EXPO_PUBLIC_FEATURE_PERCENTILE=false
EXPO_PUBLIC_FEATURE_DOCTOR_LAYER=false
EXPO_PUBLIC_FEATURE_REFERRAL_UNLOCK=false
EXPO_PUBLIC_FEATURE_YEARLY_PLAN=false
# Sprint 2/3 bayrakları: glowUp ve tryonCombo varsayılan AÇIK (yalnız "false" kapatır); productLinks kapalı.
EXPO_PUBLIC_FEATURE_PRODUCT_LINKS=false
EXPO_PUBLIC_FEATURE_GLOW_UP=true
EXPO_PUBLIC_FEATURE_TRYON_COMBO=true
# Affedici seri (ÖNERİ, yer tutucu; lib/config/routine.ts): haftada dinlenme günü 0–3, ayda dondurma 0–4
EXPO_PUBLIC_ROUTINE_REST_DAYS_PER_WEEK=1
EXPO_PUBLIC_ROUTINE_FREEZES_PER_MONTH=1
